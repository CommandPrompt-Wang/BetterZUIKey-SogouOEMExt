<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="moe.lovefirefly.betterzuikey" />
    </queries>

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.SogouOemBridge"
        android:description="@string/module_desc"
        android:allowBackup="false">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_desc" />

        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <activity
            android:name=".LangOrderActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 模块通过它读取 App 的配置（不依赖 XposedService，见 ConfigProvider 注释） -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="moe.lovefirefly.bzk.sougouext.config"
            android:exported="true" />

        <activity
            android:name=".InfoActivity"
            android:exported="false"
            android:label="原理 / 说明" />

    </application>

</manifest>
